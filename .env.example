# 复制为 .env 后填写。.env 已在 .gitignore 里，不会进仓库。
# 只有 server.py 读这个文件；浏览器永远拿不到 key。
#
# 代理只认 Anthropic Messages 协议。多家上游按顺序试，前一家失败换下一家。
# 思考默认关：这套流程全靠指定工具调用，开思考要么被拒、要么把额度花在思考上。

# 首选与回落。名字对应下面 LLM_<名>_ 那一组。
DESIGN_PROVIDER=kimi
DESIGN_FALLBACK=mimo,deepseek

# 新注册账号送多少积分。「让顾问写设计稿」「出三版视觉」各扣 1 分，
# 上游失败自动返还；本机使用不限。产品页一键生成走两段 = 2 分。
DESIGN_CREDITS=20

# 挂在反向代理（nginx 等）后面时设 1：服务器拿 X-Forwarded-For 当真实客户端 IP，
# 用于认本机（不限积分）和限注册频率。直连暴露时保持空，否则谁都能伪造这个头。
# TRUST_PROXY=

# kimi
LLM_KIMI_BASE_URL=https://api.kimi.com/coding
LLM_KIMI_API_KEY=
LLM_KIMI_MODEL=kimi-k2.5
LLM_KIMI_PROTOCOL=anthropic
LLM_KIMI_AUTH_MODE=x-api-key
LLM_KIMI_THINKING=disabled

# 小米
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=
# LLM_MIMO_MODEL=mimo-v2.5
# LLM_MIMO_PROTOCOL=anthropic
# LLM_MIMO_AUTH_MODE=x-api-key

# DeepSeek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_MODEL=deepseek-v4-flash
# LLM_DEEPSEEK_PROTOCOL=anthropic
# LLM_DEEPSEEK_AUTH_MODE=x-api-key

# 官方 Anthropic 也可以。没有 LLM_* 时会试这一组。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_BASE_URL=https://api.anthropic.com
